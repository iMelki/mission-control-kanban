# ====================================
# Mission Control Configuration
# ====================================

# Database path (default: ./mission-control.db)
DATABASE_PATH=./mission-control.db

# ====================================
# OpenClaw Gateway Configuration
# ====================================

# OpenClaw Gateway URL (default: ws://127.0.0.1:18789)
# For remote connections via Tailscale: wss://your-machine.tail12345.ts.net
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# OpenClaw Gateway authentication token (required for remote connections)
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# ====================================
# Tailscale Configuration (Railway)
# ====================================

# Tailscale Auth Key (get from Tailscale console)
TS_AUTHKEY=

# Internal hostname for this node on Tailscale
TS_HOSTNAME=mission-control

# ====================================
# Workspace Configuration
# ====================================

# Mission Control API URL (auto-detected if not set)
# Override for remote access or custom deployments
# MISSION_CONTROL_URL=http://localhost:3002

# Host port for the local Mission Control Kanban UI.
# Workspace policy reserves port 3000 for Docker/WSL infrastructure and 3001 for Mission Control.
PORT=3002

# Optional n8n alert destination for failed/error MCK sync runs.
# The local projects-ops Workflow Pack 1 destination is:
#   http://127.0.0.1:5678/webhook/projects-ops/mck-sync-alert
# Leave unset to rely only on the ignored local JSONL fallback log.
MCK_N8N_ALERT_WEBHOOK_URL=

# Optional local fallback log path for failed/error sync alerts.
# Set to off/none/disabled to disable the JSONL fallback.
# MCK_N8N_ALERT_LOG_PATH=.logs/mck-n8n-sync-alerts.jsonl

# Optional bounded run-history retention for /api/n8n/mck-sync-status.
# Defaults to 100 and is capped between 1 and 500.
# MCK_N8N_SYNC_HISTORY_LIMIT=100

# Base workspace directory (default: ~/Documents/Shared)
# All Mission Control files are stored here
# WORKSPACE_BASE_PATH=~/Documents/Shared

# Projects directory (default: ~/Documents/Shared/projects)
# Each project gets a unique folder here
# PROJECTS_PATH=~/Documents/Shared/projects

# ====================================
# Security Notes
# ====================================
#
# NEVER commit this file with real values!
# This is a template - copy to .env.local and configure:
#
#   cp .env.example .env.local
#
# Then edit .env.local with your actual values.
# .env.local is gitignored and will not be committed.
