{
  "name": "mission-control",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:n8n": "next dev --webpack --hostname 0.0.0.0 -p 3021",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:doctor-genome && npm run test:github-actions-node24 && npm run test:react-doctor-hook && npm run test:runtime-artifact-comment && npm run test:runtime-regression-server && npm run test:runtime-smoke-cleanup && npm run test:action-review && npm run test:agent-runtimes && npm run test:dispatch-adapters && npm run test:factory-webhooks && npm run test:webhook-health && npm run test:runtime-operations && npm run test:task-dependencies && npm run test:github-sync",
    "doctor:react": "node scripts/run-react-doctor.js",
    "test:react-doctor-hook": "node --test tests/react-doctor-precommit.test.mjs",
    "test:doctor-genome": "node --test tests/doctor-genome.test.mjs",
    "test:github-actions-node24": "node --test tests/github-actions-node24.test.mjs",
    "test:runtime-artifact-comment": "node --test tests/runtime-artifact-comment.test.mjs",
    "test:runtime-regression-server": "node --test tests/runtime-regression-server.test.mjs",
    "test:runtime-smoke-cleanup": "node --test tests/runtime-smoke-cleanup.test.mjs",
    "test:action-review": "node --import tsx --test tests/action-review-contract.test.ts",
    "test:github-sync": "node --import tsx --test tests/github-sync.test.ts tests/github-project-sync-persistence.test.ts",
    "test:agent-runtimes": "node --import tsx --test tests/agent-runtimes.test.ts",
    "test:dispatch-adapters": "node --import tsx --test tests/dispatch-adapters.test.ts",
    "test:factory-webhooks": "node --import tsx --test tests/factory-webhooks.test.ts",
    "test:paperclip-bridge": "npm --prefix integrations/paperclip-bridge test",
    "test:paperclip-host-migrations": "npx tsx integrations/paperclip-bridge/scripts/validate-paperclip-host-migrations.ts",
    "test:webhook-health": "node --import tsx --test tests/webhook-health.test.ts",
    "test:runtime-operations": "node --import tsx --test tests/runtime-operations.test.ts",
    "test:task-dependencies": "node --import tsx --test tests/task-dependencies.test.ts",
    "smoke:runtime-ui": "node scripts/smoke-runtime-ui.js",
    "check:runtime-regressions": "node scripts/check-runtime-regressions.js",
    "comment:runtime-artifacts": "node scripts/comment-runtime-regression-artifacts.js",
    "mock:webhook": "node scripts/mock-webhook-runtime.js",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:backup": "sqlite3 mission-control.db 'PRAGMA wal_checkpoint(TRUNCATE);' && cp mission-control.db mission-control.db.backup && echo 'Backed up to mission-control.db.backup'",
    "db:restore": "cp mission-control.db.backup mission-control.db && echo 'Restored from backup'",
    "db:reset": "rm -f mission-control.db mission-control.db-* && npm run db:seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-table": "8.21.3",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "css-tree": "^3.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.9",
    "playwright": "^1.58.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.0.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/css-tree": "^2.3.11",
    "@types/node": "^20.17.12",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "glob": "^10.4.5"
  }
}
