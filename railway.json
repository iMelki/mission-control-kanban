{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile",
        "watchPatterns": [
            "src/**",
            "public/**",
            "scripts/**",
            "next.config.mjs",
            "package.json",
            "Dockerfile"
        ]
    },
    "deploy": {
        "numReplicas": 1,
        "healthcheckPath": "/",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}